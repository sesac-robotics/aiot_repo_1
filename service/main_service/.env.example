# 이 파일은 없어도 서버가 기본값으로 실행된다. 같은 설정을 계속 쓰고 싶을 때만 .env 로 복사:  cp .env.example .env
# .env 는 Git에 올리지 않는다 (.gitignore에 포함).

# Docker 없이 서버만 직접 실행할 때 사용 (docker compose는 docker-compose.yml 값이 우선)
HCC_DB_DSN=postgresql://hcc_app:change_this_dev_password@127.0.0.1:5432/hcc

# 인증: 개발 중 false, 시연·배포 때 true + 토큰 설정
AUTH_ENABLED=false
ADMIN_TOKEN=
DEVICE_TOKEN=

# SR-05 얼굴 유사도 기준 (얼굴팀 실측 후 조정)
FACE_THRESHOLD=0.5
# 얼굴 등록 때 처음 보는 patient_id면 이름 없는 환자를 자동 생성
FACE_AUTO_CREATE_PATIENT=true

# SR-04 Door MCU가 문 상태(1=열림, 0=닫힘)를 보내는 TCP 포트
DOOR_TCP_PORT=8103
DOOR_ID=door_01

# SR-06 PC4 CCTV MCU. PC4를 직접 연결하면 serial 대신 아래 TCP를 설정
TRACK_SERIAL_PORT=
TRACK_SERIAL_BAUD=115200
# (아래 PC4_HOST와 같음)
TRACK_PC4_HOST=
TRACK_PC4_PORT=8765
TRACK_CAMERA_ID=CAM01

# PC2 추적값 TCP 수신
PC2_TCP_ENABLED=true
PC2_TCP_PORT=8102

# v2: PC4 Bridge (추적 TRACK + 문 열기 DOOR,OPEN 공용 연결). 비우면 보내지 않음
PC4_HOST=
PC4_PORT=8765
DOOR_CMD_TIMEOUT_SEC=5
DOOR_OPEN_COOLDOWN_SEC=10

# v2: 관리자 GUI 이벤트 수신기 (ui/gui/Current). 토큰을 비우면 GUI의 data/gui_event.token을 읽음
GUI_EVENT_ENABLED=true
GUI_EVENT_URL=http://127.0.0.1:8765
GUI_EVENT_TOKEN=

# door: repository legacy bridge; v: V-protocol bridge (V,body,face,dx,dy,doorPulse).
PC4_DOOR_PROTOCOL=door
# Demo only: display OPEN in GUI after a successful send, before PC4 feedback.
# Does not change the DB's reported door state or acknowledge the command.
GUI_DOOR_OPEN_ON_SEND=false
