# 이 파일은 없어도 서버가 기본값으로 실행된다. 같은 설정을 계속 쓰고 싶을 때만 .env 로 복사:  cp .env.example .env
# .env 는 Git에 올리지 않는다 (.gitignore에 포함).

# Docker 없이 서버만 직접 실행할 때 사용 (docker compose는 docker-compose.yml 값이 우선)
HCC_DB_DSN=postgresql://hcc_app:change_this_dev_password@127.0.0.1:5432/hcc

# 인증: 개발 중 false, 시연·배포 때 true + 토큰 설정
AUTH_ENABLED=false
ADMIN_TOKEN=
DEVICE_TOKEN=

# SR-05 얼굴 유사도 기준 (얼굴팀 실측 후 조정)
FACE_THRESHOLD=0.5
# 얼굴 등록 때 처음 보는 patient_id면 이름 없는 환자를 자동 생성
FACE_AUTO_CREATE_PATIENT=true

# SR-04 Door MCU가 문 상태(1=열림, 0=닫힘)를 보내는 TCP 포트
DOOR_TCP_PORT=8103
DOOR_ID=door_01

# SR-06 CCTV MCU (USB Serial). 비우면 수신만
TRACK_SERIAL_PORT=
TRACK_SERIAL_BAUD=115200
TRACK_CAMERA_ID=CAM01

# PC2 추적값 TCP 수신
PC2_TCP_ENABLED=true
PC2_TCP_PORT=8102

# GUI 모니터링 화면용 TCP 텍스트 (FALL / NORMAL / DOOR_IS_OPEN / DOOR_IS_CLOSE / RFID_IN:역할:번호:이름)
GUI_TCP_ENABLED=true
GUI_TCP_PORT=8080
