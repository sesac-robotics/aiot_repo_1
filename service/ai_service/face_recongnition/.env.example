# Copy to .env and configure locally. Never commit real tokens.
# Empty URL disables HTTP transmission; TCP is controlled separately.
PC1_EMBEDDING_URL=
PC1_EMBEDDING_TOKEN=
DEVICE_ID=PC2
PC1_TRACKING_HOST=127.0.0.1
PC1_TRACKING_PORT=8102
# Directory containing models/buffalo_l/*.onnx.
# Existing local installation: ../insightface/.models
INSIGHTFACE_MODEL_DIR=./.models
