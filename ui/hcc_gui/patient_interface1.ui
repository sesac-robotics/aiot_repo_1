    QDialog { background-color: #f4f6f9; font-family: 'Segoe UI'; }
    QTabWidget::pane { border: 2px solid #cbd5e1; border-radius: 8px; background-color: #ffffff; top: -1px; }
    QTabBar::tab { background-color: #e2e8f0; color: #475569; font-weight: bold; font-size: 13px; padding: 10px 20px; border: 1px solid #cbd5e1; border-top-left-radius: 6px; border-top-right-radius: 6px; min-width: 160px; }
    QTabBar::tab:selected { background-color: #ffffff; color: #0284c7; border-bottom-color: #ffffff; }
    QTabBar::tab:hover { background-color: #f8fafc; }
    QGroupBox { border: none; font-weight: bold; font-size: 14px; color: #2c3e50; }
    QLabel { color: #4a5568; font-weight: 500; }
    QLineEdit, QDateEdit, QComboBox { border: 1px solid #cbd5e1; border-radius: 4px; padding: 4px; background-color: #ffffff; selection-background-color: #3b82f6; }
    QLineEdit:focus, QDateEdit:focus, QComboBox:focus { border: 2px solid #0284c7; }
    QPushButton { background-color: #0284c7; color: white; border: none; border-radius: 4px; font-weight: bold; font-size: 12px; }
    QPushButton:hover { background-color: #0369a1; }
    QPushButton:pressed { background-color: #075985; }
    QPushButton#enrollButton { background-color: #10b981; }
    QPushButton#enrollButton:hover { background-color: #059669; }
    QTableWidget { background-color: #ffffff; border: 1px solid #e2e8f0; gridline-color: #cbd5e1; border-radius: 6px; }
    QHeaderView::section { background-color: #f1f5f9; color: #334155; font-weight: bold; border: 1px solid #e2e8f0; }
   </string>
