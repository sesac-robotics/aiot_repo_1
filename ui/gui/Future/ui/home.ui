    <property name="styleSheet">
      <string>QWidget { font-family: "Malgun Gothic", "Noto Sans", "DejaVu Sans"; font-size: 17px; color:#17283a; background:#fbfcfa; }
QLabel { background:transparent; }
QFrame[role="card"] {background:#ffffff;border:1px solid #dbe2dc;border-radius:6px;}
QLabel[role="title"] {font-size:32px;font-weight:700;color:#105448;}
QLabel[role="section"] {font-size:24px;font-weight:600;color:#105448;}
QLabel[role="muted"] {color:#77847f;font-size:15px;}
QPushButton {background:white;border:1px solid #bccdc5;border-radius:7px;padding:9px 18px;color:#105448;font-weight:600;}
QPushButton:hover {background:#e7f1eb;border-color:#105448;}
QPushButton[role="primary"] {background:#105448;color:white;border:0;}
QPushButton[role="danger"] {background:#fff4f3;color:#bf4741;border:1px solid #dcb3ae;}
QPushButton[role="tile"] {background:rgba(255,255,255,242);border:1px solid #b1c5bb;border-left:16px solid #105448;border-radius:6px;text-align:left;padding-left:36px;font-size:27px;color:#13223c;}
QLineEdit,QComboBox,QDateEdit,QTextEdit {background:white;border:1px solid #d4ddd7;border-radius:6px;padding:9px;selection-background-color:#105448;}
QTableWidget {background:white;alternate-background-color:#f7f9f6;border:0;selection-background-color:#e0eee6;selection-color:#105448;gridline-color:#e4e9e4;}
QHeaderView::section {background:#edf2ed;border:0;border-bottom:1px solid #dbe2dc;padding:12px;text-align:left;color:#64766a;font-weight:600;}
QTableWidget::item {padding:12px;border-bottom:1px solid #edf1ec;}
QLabel[role="open"] {background:#e1f0e6;color:#20734f;border-radius:10px;font-size:32px;font-weight:700;padding:16px;}
QLabel[role="closed"] {background:#f8e4e1;color:#b7443e;border-radius:10px;font-size:32px;font-weight:700;padding:16px;}
QLabel[role="alert"] {background:#fff0ee;color:#bd4840;border-radius:6px;padding:20px;font-size:21px;font-weight:600;}

QLineEdit,QComboBox,QDateEdit,QTextEdit {border:1px solid #cbd5df;border-radius:4px;padding:8px 12px;font-size:17px;min-height:0px;}
QHeaderView::section {background:#f2f5f1;color:#162b43;font-size:18px;border-right:1px solid #d4dce0;padding:12px;}
QTableWidget {font-size:18px;selection-background-color:#d8eae2;alternate-background-color:white;border:1px solid #d4dce0;}
QTableWidget::item {padding:10px;border-bottom:1px solid #d4dce0;border-right:1px solid #d4dce0;}
QPushButton {font-size:18px;}
</string>
    </property>
  </widget>
